# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# curated-out case-study images — Derik's local "not used" folders, never
# meant to reach a public repo (still web-accessible via direct URL even
# when unreferenced in code, since anything under public/ is served as-is)
public/case-studies/**/not used/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local playwright-cli debug artifacts (snapshots, console logs)
/.playwright-cli/
